{
  "name": "@wanderlust/web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "next dev -p 5173",
    "build": "next build",
    "start": "next start -p 5173",
    "typecheck": "tsc --noEmit",
    "lint": "pnpm run lint:eslint && pnpm run lint:stylelint",
    "lint:eslint": "eslint . --ext .ts,.tsx --cache",
    "lint:stylelint": "stylelint '**/*.css' --cache",
    "prettier": "prettier --check \"**/*.{ts,tsx}\"",
    "prettier:write": "prettier --write \"**/*.{ts,tsx}\"",
    "clean": "rm -rf dist && rm -rf node_modules",
    "vitest": "vitest run",
    "vitest:watch": "vitest",
    "test": "pnpm run typecheck && pnpm run prettier && pnpm run lint && pnpm run build && pnpm run vitest",
    "storybook": "storybook dev -p 6006",
    "storybook:build": "storybook build"
  },
  "dependencies": {
    "@auth0/nextjs-auth0": "^4.24.0",
    "@headlessui/react": "^2.1.2",
    "@heroicons/react": "^2.1.5",
    "@tabler/icons-react": "^3.11.0",
    "@tanstack/react-query": "^5.29.2",
    "@tiptap/extension-link": "^2.5.8",
    "@tiptap/react": "^2.5.8",
    "@tiptap/starter-kit": "^2.5.8",
    "@wanderlust/core": "workspace:*",
    "@wanderlust/ui": "workspace:*",
    "dayjs": "^1.11.12",
    "embla-carousel-react": "^8.1.8",
    "jotai": "^2.8.0",
    "next": "^16.2.10",
    "postcss-preset-mantine": "^1.17.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "recharts": "^2.12.7",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/montserrat": "^5.1.0",
    "styled-components": "^6.1.12"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "autoprefixer": "^10.4.20",
    "eslint": "^9.22.0",
    "eslint-config-next": "^16.2.10",
    "identity-obj-proxy": "^3.0.0",
    "jsdom": "^24.0.0",
    "postcss": "^8.4.40",
    "postcss-simple-vars": "^7.0.1",
    "prettier": "^3.2.5",
    "prop-types": "^15.8.1",
    "storybook": "^8.0.0",
    "storybook-dark-mode": "^3.0.3",
    "stylelint": "^16.2.1",
    "stylelint-config-standard-scss": "^13.0.0",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.4.2",
    "vitest": "^1.3.1"
  }
}
