{
  "name": "@wanderlust/common",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "src/assets/images",
    "src/theme/scss"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components.js",
      "default": "./dist/components.js"
    },
    "./styles.css": {
      "default": "./dist/style.css"
    },
    "./assets/*": "./src/assets/images/*",
    "./theme.scss": {
      "sass": "./src/theme/scss/theme.scss",
      "default": "./src/theme/scss/theme.scss"
    }
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json",
    "dev": "pnpm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run typecheck && pnpm run vitest",
    "vitest": "vitest run",
    "clean": "rm -rf dist"
  },
  "devDependencies": {
    "@wanderlust/build-config": "workspace:*",
    "@mdxeditor/editor": "^4.0.4",
    "@tabler/icons-react": "^3.11.0",
    "@testing-library/jest-dom": "^6.4.2",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "dockview-react": "^7.0.2",
    "next": "^16.2.10",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "sass": "^1.75.0",
    "jsdom": "^24.0.0",
    "styled-components": "^6.1.12",
    "typescript": "^5.4.2",
    "vite": "^5.4.10",
    "vitest": "^1.3.1"
  },
  "peerDependencies": {
    "@mdxeditor/editor": "^4.0.4",
    "@tabler/icons-react": "^3.11.0",
    "dockview-react": "^7.0.2",
    "next": "^16.2.10",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "styled-components": "^6.1.12"
  }
}
